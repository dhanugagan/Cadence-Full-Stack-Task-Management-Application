rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'dhanugagan2006@gmail.com'
      );
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.role is string && data.role in ['member', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'description', 'accent', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'description', 'accent', 'ownerId', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 400
        && data.accent is string && data.accent in ['slate', 'blue', 'emerald', 'amber', 'rose']
        && data.ownerId is string && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll([
          'title', 'description', 'status', 'priority', 'projectId',
          'ownerId', 'assigneeId', 'dueDate', 'estimatedMinutes',
          'loggedMinutes', 'tags', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'description', 'status', 'priority', 'projectId',
          'ownerId', 'assigneeId', 'dueDate', 'estimatedMinutes',
          'loggedMinutes', 'tags', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 4000
        && data.status is string && data.status in ['backlog', 'todo', 'in_progress', 'review', 'done', 'archived']
        && data.priority is string && data.priority in ['low', 'medium', 'high', 'urgent']
        && data.projectId is string && isValidId(data.projectId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.assigneeId is string && isValidId(data.assigneeId)
        && data.dueDate is string && data.dueDate.size() <= 32
        && data.estimatedMinutes is number && data.estimatedMinutes >= 0 && data.estimatedMinutes <= 10000
        && data.loggedMinutes is number && data.loggedMinutes >= 0 && data.loggedMinutes <= 100000
        && data.tags is list && data.tags.size() <= 8
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() >= 1 && data.tags[0].size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubtask(data, parentTaskId) {
      return data.keys().hasAll(['taskId', 'ownerId', 'title', 'completed', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['taskId', 'ownerId', 'title', 'completed', 'order', 'createdAt', 'updatedAt'])
        && data.taskId is string && data.taskId == parentTaskId && isValidId(data.taskId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.completed is bool
        && data.order is number && data.order >= 0 && data.order <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFocusSession(data) {
      return data.keys().hasAll(['taskId', 'ownerId', 'durationMinutes', 'mode', 'completedAt'])
        && data.keys().hasOnly(['taskId', 'ownerId', 'durationMinutes', 'mode', 'completedAt'])
        && data.taskId is string && isValidId(data.taskId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 180
        && data.mode is string && data.mode in ['focus', 'short_break', 'long_break']
        && data.completedAt is timestamp;
    }

    // --- Collection Rules ---
    match /admins/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().role == 'member'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'updatedAt']))
        );
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isEmailVerified()
          && isValidId(userId) && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isEmailVerified()
          && isValidId(userId) && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isEmailVerified()
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(projectId)
        && isValidProject(incoming())
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'accent', 'updatedAt']);
      allow delete: if isEmailVerified()
        && isValidId(projectId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && isSignedIn() && (
        existing().ownerId == request.auth.uid ||
        existing().assigneeId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.assigneeId == request.auth.uid
      );
      allow create: if isEmailVerified()
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid;
      allow update: if isEmailVerified()
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().status != 'archived' || isAdmin())
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            exists(/databases/$(database)/documents/projects/$(incoming().projectId)) &&
            get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid &&
            (
              // Action: Full task edit by owner
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'description', 'status', 'priority', 'projectId',
                'assigneeId', 'dueDate', 'estimatedMinutes', 'loggedMinutes',
                'tags', 'updatedAt'
              ]) ||
              // Action: Quick status transition
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
              // Action: Focus time logging
              incoming().diff(existing()).affectedKeys().hasOnly(['loggedMinutes', 'updatedAt'])
            )
          ) ||
          (
            existing().assigneeId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'loggedMinutes', 'updatedAt'])
          )
        );
      allow delete: if isEmailVerified()
        && isValidId(taskId)
        && (existing().ownerId == request.auth.uid || isAdmin());

      match /subtasks/{subtaskId} {
        allow get: if isValidId(taskId) && isValidId(subtaskId) && isSignedIn() && (
          existing().ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/tasks/$(taskId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow list: if isValidId(taskId) && isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isEmailVerified()
          && isValidId(taskId) && isValidId(subtaskId)
          && isValidSubtask(incoming(), taskId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/tasks/$(taskId))
          && get(/databases/$(database)/documents/tasks/$(taskId)).data.ownerId == request.auth.uid;
        allow update: if isEmailVerified()
          && isValidId(taskId) && isValidId(subtaskId)
          && isValidSubtask(incoming(), taskId)
          && incoming().taskId == existing().taskId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              get(/databases/$(database)/documents/tasks/$(taskId)).data.ownerId == request.auth.uid &&
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['title', 'order', 'completed', 'updatedAt'])
              )
            ) ||
            isAdmin()
          );
        allow delete: if isValidId(taskId) && isValidId(subtaskId)
          && isEmailVerified()
          && (
            get(/databases/$(database)/documents/tasks/$(taskId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    match /focusSessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isEmailVerified()
        && isValidId(sessionId)
        && isValidFocusSession(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().completedAt == request.time
        && exists(/databases/$(database)/documents/tasks/$(incoming().taskId))
        && get(/databases/$(database)/documents/tasks/$(incoming().taskId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
